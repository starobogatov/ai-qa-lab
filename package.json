{
  "name": "ai-qa-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "test:heal": "cross-env HEAL_MODE=warn playwright test --project=chromium",
    "test:heal:strict": "cross-env HEAL_MODE=strict playwright test --project=chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.21.0",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0"
  }
}
